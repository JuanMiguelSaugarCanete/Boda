---
const eventos = [
  { hora: "17:00", titulo: "Llegada de los invitados", descripcion: "Recepción y welcome drink en la entrada del venue" },
  { hora: "18:00", titulo: "Ceremonia", descripcion: "Ceremonia civil en el jardín de la propiedad" },
  { hora: "19:00", titulo: "Fotos familiares", descripcion: "Sesión de fotos con familiares y amigos" },
  { hora: "20:00", titulo: "Cóctel de bienvenida", descripcion: "Aperitivos y copas en la terraza" },
  { hora: "21:30", titulo: "Banquete", descripcion: "Menú completo con entretenimiento musical" },
  { hora: "00:00", titulo: "Primera Danza", descripcion: "La primera danza de los novios" },
  { hora: "02:00", titulo: "Fin de la fiesta", descripcion: "¡Hasta la próxima!" },
];
---

<section class="timeline-hero">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <h1>Itinerario</h1>
    <p>El día de nuestra boda</p>
  </div>
</section>

<section class="timeline-seccion">
  <div class="container">
    <div class="timeline">
      {eventos.map((evento) => (
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <span class="hora">{evento.hora}</span>
            <h3>{evento.titulo}</h3>
            <p>{evento.descripcion}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="nota-importante">
      <h3>Nota Importante</h3>
      <p>El itinerario es orientativo y puede sufrir ligeras modificaciones el día de la boda. Te recomendamos llegar con tiempo para poder disfrutar de cada momento sin prisas.</p>
    </div>
  </div>
</section>

<style>
  .timeline-hero {
    position: relative;
    height: 50vh;
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: url('https://images.unsplash.com/photo-1511285560929-80b456fea0bc?w=1920&q=80') center/cover no-repeat;
    margin-top: -70px;
    padding-top: 70px;
  }

  .timeline-seccion {
    padding: 4rem 2rem;
    background: var(--color-bg);
  }

  .timeline {
    position: relative;
    padding-left: 40px;
    max-width: 700px;
    margin: 0 auto;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--color-primary), var(--color-primary-hover));
  }

  .timeline-item {
    position: relative;
    padding-bottom: 2.5rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: -33px;
    top: 0;
    width: 18px;
    height: 18px;
    background: var(--color-primary);
    border: 4px solid var(--color-white);
    border-radius: 50%;
    box-shadow: var(--shadow-sm);
  }

  .timeline-content {
    background: var(--color-white);
    padding: 1.5rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    transition: var(--transition);
  }

  .timeline-content:hover {
    transform: translateX(5px);
  }

  .hora {
    display: inline-block;
    background: var(--color-primary);
    color: var(--color-white);
    padding: 0.25rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .timeline-content h3 {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
  }

  .timeline-content p {
    color: var(--color-body);
    line-height: 1.5;
  }

  .nota-importante {
    background: #fff8f0;
    border-left: 4px solid var(--color-primary);
    padding: 1.5rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin-top: 3rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .nota-importante h3 {
    font-family: var(--font-heading);
    margin-bottom: 0.75rem;
  }

  .nota-importante p {
    color: var(--color-body);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .timeline-hero {
      height: 40vh;
    }

    .timeline {
      padding-left: 30px;
    }

    .timeline::before {
      left: 10px;
    }

    .timeline-marker {
      left: -27px;
      width: 14px;
      height: 14px;
    }

    .timeline-content {
      padding: 1.25rem;
    }

    .timeline-content h3 {
      font-size: 1.1rem;
    }
  }
</style>
