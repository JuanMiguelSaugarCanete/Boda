---

---

<section class="canciones-hero">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <h1>Sugerir una Canción</h1>
    <p>¿Qué canción no puede faltar en nuestra boda? Búscala en Spotify y añádela a nuestra playlist.</p>
  </div>
</section>

<section class="canciones-seccion">
  <div class="canciones-wrap">
    <div class="spotify-search-wrap">
      <svg class="spotify-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="song-search" placeholder="Busca una canción o un artista..." autocomplete="off" />
    </div>
    <ul class="spotify-results" id="spotify-results"></ul>

    <div class="spotify-added">
      <div class="added-head">
        <h3>Canciones añadidas</h3>
        <span class="added-count" id="added-count">0</span>
      </div>
      <p class="added-empty" id="added-empty">Aún no hay canciones en la playlist. ¡Sé el primero en sugerir una!</p>
      <div class="song-cards" id="song-cards"></div>
    </div>

    <p class="form-status" id="spotify-status"></p>
  </div>
</section>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Ubuntu:wght@300;400;500;700&display=swap');

  .canciones-hero {
    position: relative;
    height: 35vh;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: url('https://images.unsplash.com/photo-1470225620780-dba8ba36b745?w=1920&q=80') center/cover no-repeat;
    margin-top: -70px;
    padding-top: 70px;
  }

  .canciones-seccion {
    padding: 3rem 2rem;
    background: var(--color-bg);
    min-height: calc(100vh - 35vh - 70px);
  }

  .canciones-wrap {
    max-width: 2000px;
    margin: 0 auto;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-sm);

    --orange: #F78A52;
    --ltorg: #F3C56F;
    --yellow: #FEFAD7;
    --tan: #E6E3DA;
    --tan-dark: #D2CCBE;
    --tan-text: #6D6352;
  }

  .spotify-search-wrap {
    position: relative;
    max-width: 560px;
    margin-bottom: 3rem;
  }

  .spotify-search-icon {
    position: absolute;
    left: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    color: var(--orange);
    pointer-events: none;
  }

  #song-search {
    width: 100%;
    padding: 1rem 1.1rem 1rem 3rem;
    border: 2px solid var(--tan-dark);
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: 1rem;
    background: var(--yellow);
    color: var(--tan-text);
    transition: var(--transition);
  }

  #song-search::placeholder {
    color: var(--tan-text);
    opacity: 0.7;
  }

  #song-search:focus {
    outline: none;
    border-color: var(--orange);
    background: var(--color-white);
    box-shadow: 0 0 0 4px var(--yellow);
  }

  .spotify-results {
    list-style: none;
    margin: 0 0 3.5rem;
    padding: 0 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 560px;
    max-height: 420px;
    overflow-y: auto;
    background: var(--tan);
    border: 2px solid var(--orange);
    border-radius: 0 20px 20px 20px;
    box-shadow: 0 0 0 4px var(--yellow) inset;
  }

  .spotify-track {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.55em 0.4em;
    border-bottom: 1px solid var(--tan-dark);
    color: var(--tan-text);
    transition: color 0.2s ease;
  }

  .spotify-track:last-child {
    border-bottom: none;
  }

  .spotify-track:hover {
    color: #000;
  }

  .spotify-track img,
  .spotify-track-thumb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    box-shadow: inset 0 0 0 2px rgba(0, 0, 0, 0.05);
  }

  .spotify-track-thumb {
    background: var(--ltorg);
    color: #A8623A;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  .spotify-track-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .spotify-track-name {
    font-weight: 700;
    color: var(--tan-text);
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .spotify-track-artist {
    font-size: 0.78rem;
    color: var(--tan-text);
    opacity: 0.8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .spotify-track-album {
    display: none;
  }

  .spotify-add-btn {
    background: var(--orange);
    color: var(--color-white);
    padding: 0.5rem 1.1rem;
    border-radius: 50px;
    font-size: 0.82rem;
    font-weight: 700;
    flex-shrink: 0;
    transition: var(--transition);
  }

  .spotify-add-btn:hover:not(:disabled) {
    background: #DF7B46;
    transform: translateY(-1px);
  }

  .spotify-add-btn:disabled {
    background: var(--yellow);
    color: var(--orange);
    cursor: default;
  }

  .spotify-added {
    margin-top: 4rem;
    max-width: 100%;
  }

  .added-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--tan-dark);
  }

  .added-head h3 {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    color: var(--tan-text);
  }

  .added-count {
    background: var(--orange);
    color: var(--color-white);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.2rem 0.9rem;
    border-radius: 50px;
  }

  .song-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 5rem;
  }

.song-card {
    background: #e7e7e7;
    border-radius: 20px;
    padding: 0.75rem;
    text-align: center;
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.12);
    transition: all 0.5s ease;
    position: relative;
  }

  .song-card:hover {
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.28);
    transform: translateY(-3px);
  }

  .track-embed {
    width: 100%;
    border-radius: 14px;
    overflow: hidden;
  }

  .track-embed iframe {
    width: 100%;
    height: 152px;
    border: none;
    display: block;
  }

  .added-empty {
    color: var(--tan-text);
    font-size: 0.9rem;
    font-style: italic;
    text-align: center;
    padding: 1.5rem 0;
  }

  .form-status {
    font-size: 0.9rem;
    color: var(--color-success);
  }

  @media (max-width: 920px) {
    .song-cards {
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 1.75rem 1.25rem;
    }
  }
</style>

<script>
  import { requireAuth } from '../utils/auth';

  const SPOTIFY_API_URL = import.meta.env.PUBLIC_SPOTIFY_API_URL || 'http://localhost:8083';

  // Página protegida: sin sesión válida se redirige a /login
  await requireAuth();

  const songSearch = document.getElementById('song-search') as HTMLInputElement;
  const spotifyResults = document.getElementById('spotify-results');
  const spotifyStatus = document.getElementById('spotify-status');
  const songCards = document.getElementById('song-cards');
  const addedCount = document.getElementById('added-count');
  const addedEmpty = document.getElementById('added-empty');

  let searchTimeout: ReturnType<typeof setTimeout>;
  let searchAbort: AbortController | null = null;

  let addedTracks: any[] = [];
  const addedUris = new Set<string>();

  const setSpotifyStatus = (msg: string, isError = false) => {
    if (spotifyStatus) {
      spotifyStatus.textContent = msg;
      spotifyStatus.style.color = isError ? 'var(--color-error)' : 'var(--color-success)';
    }
  };

  function makeThumb(kind: string) {
    const thumb = document.createElement('div');
    thumb.className = `${kind}-thumb`;
    thumb.textContent = '🎵';
    return thumb;
  }

  // Carga las canciones ya añadidas a la playlist del backend
  async function loadPlaylist() {
    try {
      const res = await fetch(`${SPOTIFY_API_URL}/api/spotify/playlist`);
      if (!res.ok) throw new Error();
      const playlist = await res.json();
      addedTracks = playlist.tracks || [];
      addedTracks.forEach((track) => {
        if (track.uri) addedUris.add(track.uri);
      });
      renderAddedTracks();
    } catch {
      if (addedEmpty) {
        addedEmpty.textContent = 'No se ha podido cargar la playlist de momento.';
      }
    }
  }

  function renderAddedTracks() {
    if (!songCards) return;
    songCards.innerHTML = '';
    if (addedCount) addedCount.textContent = String(addedTracks.length);

    if (!addedTracks.length) {
      if (addedEmpty) addedEmpty.style.display = 'block';
      return;
    }
    if (addedEmpty) addedEmpty.style.display = 'none';

    const ordered = addedTracks.slice().reverse();
    ordered.forEach((track) => {
      const card = document.createElement('div');
      card.className = 'song-card';

if (track.id) {
        const embedWrap = document.createElement('div');
        embedWrap.className = 'track-embed';
        const iframe = document.createElement('iframe');
        iframe.src = `https://open.spotify.com/embed/track/${encodeURIComponent(track.id)}?theme=0`;
        iframe.width = '100%';
        iframe.height = '152';
        iframe.setAttribute('frameBorder', '0');
        iframe.setAttribute(
          'allow',
          'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture'
        );
        iframe.loading = 'lazy';
        embedWrap.appendChild(iframe);
        card.appendChild(embedWrap);
      }

      songCards.appendChild(card);
    });
  }

  songSearch?.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    const query = songSearch.value.trim();

    if (query.length < 3) {
      searchAbort?.abort();
      if (spotifyResults) spotifyResults.innerHTML = '';
      return;
    }

    searchTimeout = setTimeout(async () => {
      searchAbort?.abort();
      searchAbort = new AbortController();

      try {
        const res = await fetch(
          `${SPOTIFY_API_URL}/api/spotify/search?q=${encodeURIComponent(query)}`,
          { signal: searchAbort.signal }
        );
        if (!res.ok) throw new Error();
        const tracks = await res.json();
        renderTracks(tracks);
      } catch (err) {
        if ((err as Error).name === 'AbortError') return;
        if (spotifyResults) spotifyResults.innerHTML = '';
        setSpotifyStatus('Error al buscar en Spotify', true);
      }
    }, 300);
  });

  function renderTracks(tracks: any[]) {
    if (!spotifyResults) return;
    spotifyResults.innerHTML = '';

    if (!tracks.length) {
      const li = document.createElement('li');
      li.className = 'spotify-track';
      li.textContent = 'No se han encontrado canciones';
      spotifyResults.appendChild(li);
      return;
    }

    tracks.forEach((track) => {
      const li = document.createElement('li');
      li.className = 'spotify-track';

      if (track.image) {
        const img = document.createElement('img');
        img.src = track.image;
        img.alt = track.album || '';
        img.loading = 'lazy';
        li.appendChild(img);
      } else {
        li.appendChild(makeThumb('spotify-track'));
      }

      const info = document.createElement('div');
      info.className = 'spotify-track-info';

      const name = document.createElement('span');
      name.className = 'spotify-track-name';
      name.textContent = track.name;

      const artist = document.createElement('span');
      artist.className = 'spotify-track-artist';
      artist.textContent = (track.artists || []).join(', ');

      info.appendChild(name);
      info.appendChild(artist);

      if (track.album) {
        const album = document.createElement('span');
        album.className = 'spotify-track-album';
        album.textContent = track.album;
        info.appendChild(album);
      }

      li.appendChild(info);

      const addBtn = document.createElement('button');
      addBtn.type = 'button';
      addBtn.className = 'spotify-add-btn';
      if (track.uri && addedUris.has(track.uri)) {
        addBtn.disabled = true;
        addBtn.textContent = 'Añadida ✓';
      } else {
        addBtn.textContent = 'Añadir';
        addBtn.addEventListener('click', () => addTrack(track, addBtn));
      }
      li.appendChild(addBtn);

      spotifyResults.appendChild(li);
    });
  }

  async function addTrack(track: any, btn: HTMLButtonElement) {
    btn.disabled = true;
    btn.textContent = 'Añadiendo...';

    try {
      const res = await fetch(`${SPOTIFY_API_URL}/api/spotify/playlist/tracks`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ uri: track.uri }),
      });

      if (res.ok) {
        btn.textContent = 'Añadida ✓';
        if (track.uri) addedUris.add(track.uri);
        addedTracks.push(track);
        renderAddedTracks();
        setSpotifyStatus(`¡"${track.name}" añadida a la playlist! Gracias por tu aporte musical`);
      } else if (res.status === 401) {
        btn.disabled = false;
        btn.textContent = 'Añadir';
        setSpotifyStatus('Spotify no está autorizado en el servidor', true);
      } else if (res.status === 409) {
        btn.disabled = true;
        btn.textContent = 'Añadida ✓';
        if (track.uri) addedUris.add(track.uri);
        setSpotifyStatus(`"${track.name}" ya está en la playlist`, true);
      } else {
        throw new Error();
      }
    } catch {
      btn.disabled = false;
      btn.textContent = 'Añadir';
      setSpotifyStatus('Error al añadir la canción', true);
    }
  }

  loadPlaylist();
</script>
