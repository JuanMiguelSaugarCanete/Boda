---

---

<section class="panel-hero">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <h1>Mi Panel</h1>
    <p id="welcome-name">Bienvenido</p>
  </div>
</section>

<section class="panel-seccion">
  <div class="panel-container">
    <aside class="panel-sidebar">
      <button class="sidebar-btn active" data-section="info">
        <span class="sidebar-icon">👤</span>
        Mi Información
      </button>
      <button class="sidebar-btn" data-section="asistencia">
        <span class="sidebar-icon">✅</span>
        Asistencia
      </button>
      <button class="sidebar-btn" data-section="alergenos">
        <span class="sidebar-icon">⚠️</span>
        Alérgenos
      </button>
      <button class="sidebar-btn" data-section="familia">
        <span class="sidebar-icon">👨‍👩‍👧</span>
        Mi Familia
      </button>
      <a class="sidebar-btn sidebar-link" href="/canciones">
        <span class="sidebar-icon">🎵</span>
        Sugerir Canción
      </a>
      <button class="sidebar-btn logout-btn" id="logout-btn">
        <span class="sidebar-icon">🚪</span>
        Cerrar Sesión
      </button>
    </aside>

    <div class="panel-content">
      <div class="panel-section active" id="section-info">
        <h2>Mi Información</h2>
        <form class="panel-form" id="info-form">
          <div class="profile-box">
            <img id="info-avatar" class="profile-avatar" alt="Foto de perfil" />
            <div class="profile-box-copy">
              <strong>Foto de perfil</strong>
              <p>Esta imagen se verá en tu panel y en la barra de navegación.</p>
            </div>
          </div>
          <div class="form-group">
            <label for="info-imgProfile">Cambiar foto</label>
            <input type="file" id="info-imgProfile" accept="image/*" />
          </div>
          <div class="form-group">
            <label>Nombre</label>
            <input type="text" id="info-name" disabled />
          </div>
          <div class="form-group">
            <label>Apellidos</label>
            <input type="text" id="info-lastname" disabled />
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" id="info-email" disabled />
          </div>
          <div class="form-group">
            <label>Teléfono</label>
            <input type="tel" id="info-phone" placeholder="612345678" />
          </div>
          <button type="submit" class="btn-save">Guardar cambios</button>
          <p class="form-status" id="info-status"></p>
        </form>
      </div>

      <div class="panel-section" id="section-asistencia">
        <h2>Confirmar Asistencia</h2>
        <p class="panel-intro">¿Nos acompañarás en nuestro gran día?</p>
        <div class="asistencia-options">
          <button class="asistencia-btn" data-value="SI">
            <span class="asistencia-icon">🎉</span>
            ¡Sí, allí estaré!
          </button>
          <button class="asistencia-btn" data-value="NO">
            <span class="asistencia-icon">😢</span>
            No podré asistir
          </button>
          <button class="asistencia-btn" data-value="AUN_NO_SE">
            <span class="asistencia-icon">🤔</span>
            Aún no lo sé
          </button>
        </div>
        <button class="btn-save" id="save-asistencia">Actualizar asistencia</button>
        <p class="form-status" id="asistencia-status"></p>
      </div>

      <div class="panel-section" id="section-alergenos">
        <h2>Alérgenos e Intolerancias</h2>
        <p class="panel-intro">Queremos que disfrutes del menú sin preocupaciones.</p>
        <div class="alergenos-grid">
          <label class="alergeno-check"><input type="checkbox" value="GLUTEN" /> 🌾 Gluten</label>
          <label class="alergeno-check"><input type="checkbox" value="LACTOSE" /> 🥛 Lactosa</label>
          <label class="alergeno-check"><input type="checkbox" value="NUTS" /> 🥜 Frutos Secos</label>
          <label class="alergeno-check"><input type="checkbox" value="SEAFOOD" /> 🦐 Marisco</label>
          <label class="alergeno-check"><input type="checkbox" value="FISH" /> 🐟 Pescado</label>
          <label class="alergeno-check"><input type="checkbox" value="EGG" /> 🥚 Huevo</label>
          <label class="alergeno-check"><input type="checkbox" value="SOY" /> 🫘 Soja</label>
        </div>
        <div class="form-group">
          <label>Otras intolerancias o notas</label>
          <textarea id="alergen-notes" rows="3" placeholder="Especifica aquí cualquier otra alergia o intolerancia..."></textarea>
        </div>
        <button class="btn-save" id="save-alergenos">Guardar alérgenos</button>
        <p class="form-status" id="alergenos-status"></p>
      </div>

      <div class="panel-section" id="section-familia">
        <h2>Mi Familia</h2>
        <p class="panel-intro">Gestiona la información de todos los miembros de tu familia. Los cambios se guardan para cada miembro.</p>
        <div class="family-list" id="family-list"></div>
      </div>

    </div>
  </div>
</section>

<style is:global>
  .panel-hero {
    position: relative;
    height: 35vh;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: url('https://images.unsplash.com/photo-1519741497674-611481863552?w=1920&q=80') center/cover no-repeat;
    margin-top: -70px;
    padding-top: 70px;
  }

  .panel-seccion {
    padding: 3rem 2rem;
    background: var(--color-bg);
    min-height: calc(100vh - 35vh - 70px);
  }

  .panel-container {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem;
  }

  .panel-sidebar {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    height: fit-content;
    position: sticky;
    top: 90px;
  }

  .sidebar-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.85rem 1rem;
    background: none;
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    color: var(--color-body);
    text-align: left;
    transition: var(--transition);
  }

  .sidebar-btn:hover {
    background: var(--color-bg);
  }

  .sidebar-btn.active {
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-weight: 600;
  }

  .sidebar-icon {
    font-size: 1.2rem;
  }

  .logout-btn {
    margin-top: 1rem;
    border-top: 1px solid var(--color-card-bg);
    padding-top: 1rem;
    color: var(--color-error);
  }

  .panel-content {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-sm);
  }

  .panel-section {
    display: none;
  }

  .panel-section.active {
    display: block;
  }

  .panel-section h2 {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
  }

  .panel-intro {
    color: var(--color-body-light);
    margin-bottom: 2rem;
    font-size: 1.05rem;
  }

  .panel-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 500px;
  }

  .profile-box {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: var(--color-bg);
    border-radius: var(--radius-md);
  }

  .profile-avatar {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-card-bg);
    border: 3px solid var(--color-white);
    box-shadow: var(--shadow-sm);
  }

  .profile-box-copy p {
    color: var(--color-body-light);
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-weight: 500;
    color: var(--color-dark);
    font-size: 0.9rem;
  }

  .form-group input,
  .form-group textarea,
  .form-group select {
    padding: 0.85rem 1rem;
    border: 2px solid var(--color-card-bg);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 1rem;
    transition: var(--transition);
    background: var(--color-white);
  }

  .form-group input:focus,
  .form-group textarea:focus,
  .form-group select:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .form-group input:disabled {
    background: var(--color-bg);
    cursor: not-allowed;
  }

  .form-group textarea {
    resize: vertical;
  }

  .btn-save {
    background: var(--color-primary);
    color: var(--color-white);
    padding: 0.85rem 2rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    align-self: flex-start;
    cursor: pointer;
  }

  .btn-save:hover {
    background: var(--color-primary-hover);
    transform: translateY(-2px);
  }

  .form-status {
    font-size: 0.9rem;
    color: var(--color-success);
  }

  .asistencia-options {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 400px;
  }

  .asistencia-btn {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: var(--color-bg);
    border: 2px solid var(--color-card-bg);
    border-radius: var(--radius-md);
    font-size: 1.05rem;
    color: var(--color-dark);
    transition: var(--transition);
  }

  .asistencia-btn:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .asistencia-btn.selected {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .asistencia-icon {
    font-size: 1.5rem;
  }

  #save-asistencia {
    margin-top: 1.5rem;
  }

  .alergenos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0.75rem;
  }

  .alergeno-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--color-bg);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: var(--transition);
  }

  .alergeno-check:has(input:checked) {
    background: var(--color-primary-light);
    border: 1px solid var(--color-primary);
  }

  .family-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .family-card {
    border: 2px solid var(--color-card-bg);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .family-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .family-card-main {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .family-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-card-bg);
    flex-shrink: 0;
  }

  .family-card-head h3 {
    font-family: var(--font-heading);
    font-size: 1.3rem;
  }

  .family-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }

  .family-save {
    align-self: flex-end;
    margin-top: 0.5rem;
  }

  .family-card-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .panel-container {
      grid-template-columns: 1fr;
    }

    .panel-sidebar {
      position: static;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .sidebar-btn {
      width: auto;
      padding: 0.6rem 1rem;
      font-size: 0.85rem;
    }

    .logout-btn {
      margin-top: 0;
      border-top: none;
      padding-top: 0.6rem;
    }
  }
</style>
<script>
  import { requireAuth, logout, findLoggedPerson, restoreSession, resolveProfileImageUrl, getApiUrl, getImagesApiUrl } from '../utils/auth';

  const API_URL = getApiUrl();
  const IMAGES_API_URL = getImagesApiUrl();

  const ALLERGENS = [
    { value: 'GLUTEN', label: '🌾 Gluten' },
    { value: 'LACTOSE', label: '🥛 Lactosa' },
    { value: 'NUTS', label: '🥜 Frutos Secos' },
    { value: 'SEAFOOD', label: '🦐 Marisco' },
    { value: 'FISH', label: '🐟 Pescado' },
    { value: 'EGG', label: '🥚 Huevo' },
    { value: 'SOY', label: '🫘 Soja' },
  ];

  const DIETS = [
    { value: 'NINGUNA', label: 'Sin preferencia' },
    { value: 'VEGETARIANA', label: 'Vegetariana' },
    { value: 'VEGANA', label: 'Vegana' },
    { value: 'OTRA', label: 'Otra' },
  ];

  const ATTENDANCE_OPTIONS = [
    { value: 'SI', label: 'Sí' },
    { value: 'NO', label: 'No' },
    { value: 'AUN_NO_SE', label: 'Aún no lo sé' },
  ];

  let sessionEmail = '';
  let token: string | null = null;

  function placeholderAvatar(name: string): string {
    const label = (name || 'Miembro').trim().slice(0, 2).toUpperCase();
    return `data:image/svg+xml;charset=UTF-8,${encodeURIComponent(`
      <svg xmlns="http://www.w3.org/2000/svg" width="160" height="160" viewBox="0 0 160 160">
        <rect width="160" height="160" rx="80" fill="#f2e6e6"/>
        <text x="80" y="94" text-anchor="middle" font-family="Arial, sans-serif" font-size="54" font-weight="700" fill="#8b5a5a">${label}</text>
      </svg>
    `)}`;
  }

  async function setImageFromKey(img: HTMLImageElement | null, key?: string | null, fallbackName = 'Miembro') {
    if (!img) return;
    const url = await resolveProfileImageUrl(key);
    img.src = url || placeholderAvatar(fallbackName);
  }

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function optionsHtml(options: { value: string; label: string }[], selected: string | undefined, placeholder: string): string {
    const hasValue = options.some((o) => o.value === selected);
    const placeholderOpt = hasValue ? '' : `<option value="">${placeholder}</option>`;
    return placeholderOpt + options
      .map((o) => `<option value="${o.value}" ${o.value === selected ? 'selected' : ''}>${o.label}</option>`)
      .join('');
  }

  function renderFamily(people: any[]) {
    const list = document.getElementById('family-list');
    if (!list) return;

    list.innerHTML = '';

    people
      .filter((person) => !(person?.email && person.email.trim().toLowerCase() === sessionEmail))
      .forEach((person) => {
        const card = document.createElement('article');
        card.className = 'family-card';
        if (person?.personId) card.dataset.personId = person.personId;

        card.innerHTML = `
        <div class="family-card-head">
          <div class="family-card-main">
            <img class="family-avatar" alt="Foto de ${escapeHtml(person.name || 'Miembro')}" />
            <h3>${escapeHtml(person.name || 'Miembro')}</h3>
          </div>
        </div>
        <div class="family-card-grid">
          <div class="form-group">
            <label>Nombre</label>
            <input type="text" class="f-name" value="${escapeHtml(person.name || '')}" />
          </div>
          <div class="form-group">
            <label>Teléfono</label>
            <input type="tel" class="f-tlf" value="${escapeHtml(person.tlf || '')}" placeholder="612345678" />
          </div>
          <div class="form-group">
            <label>Foto de perfil</label>
            <input type="file" class="f-imgProfile" accept="image/*" />
          </div>
          <div class="form-group">
            <label>Asistencia</label>
            <select class="f-attendance">${optionsHtml(ATTENDANCE_OPTIONS, person.attendance, 'Sin confirmar')}</select>
          </div>
          <div class="form-group">
            <label>Dieta</label>
            <select class="f-diet">${optionsHtml(DIETS, person.diet, 'Sin preferencia')}</select>
          </div>
        </div>
        <div class="form-group">
          <label>Alérgenos</label>
          <div class="alergenos-grid">
            ${ALLERGENS.map((a) => `
              <label class="alergeno-check">
                <input type="checkbox" class="f-allergen" value="${a.value}" ${(person.allergens || []).includes(a.value) ? 'checked' : ''} />
                ${a.label}
              </label>`).join('')}
          </div>
        </div>
        <div class="form-group">
          <label>Otras intolerancias o notas</label>
          <textarea class="f-notes" rows="2" placeholder="Especifica aquí cualquier otra alergia o intolerancia...">${escapeHtml(person.dietNotes || '')}</textarea>
        </div>
        <div class="family-card-actions">
          <p class="form-status family-status"></p>
          <button class="btn-save family-save">Guardar</button>
        </div>
      `;

      list.appendChild(card);

      void setImageFromKey(card.querySelector('.family-avatar') as HTMLImageElement | null, person?.imgProfile, person?.name || 'Miembro');
    });
  }

  function attachFamilySaveHandlers() {
    document.querySelectorAll('.family-card').forEach((card) => {
      const saveBtn = card.querySelector('.family-save');
      const status = card.querySelector('.family-status') as HTMLElement;

      saveBtn?.addEventListener('click', async () => {
        const personId = (card as HTMLElement).dataset.personId;
        const imageInput = card.querySelector('.f-imgProfile') as HTMLInputElement | null;

        if (!personId) {
          status.textContent = 'Miembro sin identificar. Actualiza la página e inténtalo de nuevo.';
          status.style.color = 'var(--color-error)';
          return;
        }

        let imgProfile: string | null = null;
        const file = imageInput?.files?.[0];
        if (file) {
          const formData = new FormData();
          formData.append('file', file);
          const uploadRes = await fetch(`${IMAGES_API_URL}/api/images?folder=${encodeURIComponent('imgProfile')}`, {
            method: 'POST',
            body: formData,
          });
          const uploadData = await uploadRes.json().catch(() => ({}));
          if (!uploadRes.ok || !uploadData.key) {
            status.textContent = uploadData.error || 'No se pudo subir la foto.';
            status.style.color = 'var(--color-error)';
            return;
          }
          imgProfile = uploadData.key;
        }

        const payload: Record<string, unknown> = {
          name: (card.querySelector('.f-name') as HTMLInputElement).value,
          tlf: (card.querySelector('.f-tlf') as HTMLInputElement).value,
          attendance: (card.querySelector('.f-attendance') as HTMLSelectElement).value,
          diet: (card.querySelector('.f-diet') as HTMLSelectElement).value,
          dietNotes: (card.querySelector('.f-notes') as HTMLTextAreaElement).value,
          allergens: Array.from(card.querySelectorAll('.f-allergen:checked')).map((cb) => (cb as HTMLInputElement).value),
        };
        if (imgProfile) payload.imgProfile = imgProfile;

        status.textContent = 'Guardando...';
        status.style.color = 'var(--color-body-light)';

        try {
          const res = await fetch(`${API_URL}/api/users/people/${encodeURIComponent(personId)}`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`,
            },
            body: JSON.stringify(payload),
          });

          const data = await res.json().catch(() => ({}));

          if (res.ok) {
            status.textContent = 'Guardado correctamente';
            status.style.color = 'var(--color-success)';
            const refreshed = await restoreSession();
            if (refreshed) {
              sessionEmail = refreshed.email || sessionEmail;
              renderFamily(refreshed.family?.people || []);
              attachFamilySaveHandlers();
              populateSelfData(refreshed);
            }
          } else {
            throw new Error(data.error || 'Error al guardar');
          }
        } catch (e) {
          status.textContent = e instanceof Error ? e.message : 'Error al guardar';
          status.style.color = 'var(--color-error)';
        }
      });
    });
  }

  function populateSelfData(session: any) {
    const person = findLoggedPerson(session.family, sessionEmail);

    const welcomeName = document.getElementById('welcome-name');
    if (welcomeName && person?.name) welcomeName.textContent = `Bienvenido, ${person.name}`;

    void setImageFromKey(document.getElementById('info-avatar') as HTMLImageElement | null, person?.imgProfile, person?.name || 'Miembro');

    const nameInput = document.getElementById('info-name') as HTMLInputElement;
    const lastnameInput = document.getElementById('info-lastname') as HTMLInputElement;
    const emailInput = document.getElementById('info-email') as HTMLInputElement;
    const phoneInput = document.getElementById('info-phone') as HTMLInputElement;

    if (nameInput) nameInput.value = person?.name || '';
    if (lastnameInput) lastnameInput.value = person?.lastName || '';
    if (emailInput) emailInput.value = person?.email || sessionEmail || '';
    if (phoneInput) phoneInput.value = person?.tlf || '';

    if (person?.attendance) {
      document.querySelectorAll('.asistencia-btn').forEach((b) => b.classList.remove('selected'));
      document
        .querySelector(`.asistencia-btn[data-value="${person.attendance}"]`)
        ?.classList.add('selected');
    }

    if (Array.isArray(person?.allergens)) {
      document.querySelectorAll('.alergeno-check input').forEach((cb) => {
        (cb as HTMLInputElement).checked = person.allergens.includes(
          (cb as HTMLInputElement).value
        );
      });
    }
    const notesInput = document.getElementById('alergen-notes') as HTMLTextAreaElement;
    if (notesInput) notesInput.value = person?.dietNotes || '';
  }

  const sidebarBtns = document.querySelectorAll('.sidebar-btn:not(.logout-btn):not(.sidebar-link)');
  const sections = document.querySelectorAll('.panel-section');

  sidebarBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      sidebarBtns.forEach((b) => b.classList.remove('active'));
      sections.forEach((s) => s.classList.remove('active'));
      btn.classList.add('active');
      const target = btn.getAttribute('data-section');
      document.getElementById(`section-${target}`)?.classList.add('active');
    });
  });

  document.getElementById('logout-btn')?.addEventListener('click', () => {
    logout();
  });

  // Restaura la sesión validando el token contra el backend.
  // Si no hay sesión válida, requireAuth redirige a /login.
  const session = await requireAuth();
  token = session?.token ?? null;
  sessionEmail = session?.email ?? '';

  if (session) {
    populateSelfData(session);
    renderFamily(session.family?.people || []);
    attachFamilySaveHandlers();
  }

  const infoForm = document.getElementById('info-form');
  const infoStatus = document.getElementById('info-status');

  infoForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const phone = (document.getElementById('info-phone') as HTMLInputElement).value;
    const name = (document.getElementById('info-name') as HTMLInputElement).value;
    const imageInput = document.getElementById('info-imgProfile') as HTMLInputElement | null;

    try {
      let imgProfile: string | null = null;
      const file = imageInput?.files?.[0];
      if (file) {
        const formData = new FormData();
        formData.append('file', file);
          const uploadRes = await fetch(`${IMAGES_API_URL}/api/images?folder=${encodeURIComponent('imgProfile')}`, {
          method: 'POST',
          body: formData,
        });
        const uploadData = await uploadRes.json().catch(() => ({}));
        if (!uploadRes.ok || !uploadData.key) {
          throw new Error(uploadData.error || 'No se pudo subir la foto.');
        }
        imgProfile = uploadData.key;
      }

      const payload: Record<string, unknown> = { phone, name };
      if (imgProfile) payload.imgProfile = imgProfile;

      const res = await fetch(`${API_URL}/api/users/me`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`,
        },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        if (infoStatus) {
          infoStatus.textContent = 'Información actualizada correctamente';
          infoStatus.style.color = 'var(--color-success)';
        }
        const refreshed = await restoreSession();
        if (refreshed) {
          renderFamily(refreshed.family?.people || []);
          attachFamilySaveHandlers();
          populateSelfData(refreshed);
        }
      } else {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.error || 'Error al actualizar');
      }
    } catch (err) {
      if (infoStatus) {
        infoStatus.textContent = err instanceof Error ? err.message : 'Error al actualizar';
        infoStatus.style.color = 'var(--color-error)';
      }
    }
  });

  // Los botones de asistencia solo marcan la selección; se guarda con "Actualizar asistencia"
  document.querySelectorAll('.asistencia-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.asistencia-btn').forEach((b) => b.classList.remove('selected'));
      btn.classList.add('selected');
    });
  });

  const saveAsistencia = document.getElementById('save-asistencia');
  const asistenciaStatus = document.getElementById('asistencia-status');

  saveAsistencia?.addEventListener('click', async () => {
    const selected = document.querySelector('.asistencia-btn.selected');
    const value = selected?.getAttribute('data-value');

    if (!value) {
      if (asistenciaStatus) {
        asistenciaStatus.textContent = 'Selecciona una opción primero';
        asistenciaStatus.style.color = 'var(--color-error)';
      }
      return;
    }

    try {
      const res = await fetch(`${API_URL}/api/users/rsvp`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`,
        },
        body: JSON.stringify({ attendance: value }),
      });

      if (res.ok) {
        if (asistenciaStatus) {
          asistenciaStatus.textContent = 'Asistencia actualizada. ¡Gracias!';
          asistenciaStatus.style.color = 'var(--color-success)';
        }
      } else {
        throw new Error();
      }
    } catch {
      if (asistenciaStatus) {
        asistenciaStatus.textContent = 'Error al actualizar';
        asistenciaStatus.style.color = 'var(--color-error)';
      }
    }
  });

  const saveAlergenos = document.getElementById('save-alergenos');
  const alergenosStatus = document.getElementById('alergenos-status');

  saveAlergenos?.addEventListener('click', async () => {
    const checkboxes = document.querySelectorAll('#section-alergenos .alergeno-check input:checked');
    const allergens = Array.from(checkboxes).map((cb) => (cb as HTMLInputElement).value);
    const notes = (document.getElementById('alergen-notes') as HTMLTextAreaElement).value;

    try {
      const res = await fetch(`${API_URL}/api/users/allergens`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`,
        },
        body: JSON.stringify({ allergens, notes }),
      });

      if (res.ok) {
        if (alergenosStatus) {
          alergenosStatus.textContent = 'Alérgenos guardados correctamente';
          alergenosStatus.style.color = 'var(--color-success)';
        }
      } else {
        throw new Error();
      }
    } catch {
      if (alergenosStatus) {
        alergenosStatus.textContent = 'Error al guardar';
        alergenosStatus.style.color = 'var(--color-error)';
      }
    }
  });

</script>
