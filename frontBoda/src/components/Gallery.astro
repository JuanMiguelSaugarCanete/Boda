---

---

<section class="gallery-hero">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <h1>Galería de Imágenes</h1>
    <p>Los mejores momentos de nuestro día especial</p>
  </div>
</section>

<section class="gallery-seccion">
  <div class="container">
    <div class="upload-zone" id="upload-zone">
      <div class="upload-icon">📸</div>
      <h3>Sube tus fotos y videos</h3>
      <p>Arrastra tus imágenes o videos aquí, o haz clic para seleccionar</p>
      <input type="file" id="file-input" accept="image/*,video/*" multiple hidden />
      <button class="btn-upload" id="btn-upload">Seleccionar archivos</button>
      <p class="upload-hint">Inicia sesión para poder subir fotos y videos</p>
    </div>

    <div class="gallery-grid" id="gallery-grid"></div>
    <p class="gallery-empty" id="gallery-empty" style="display: none;">
      Todavía no hay fotos ni videos subidos — ¡sé el primero en compartir tus momentos!
    </p>
  </div>
</section>

<div class="lightbox" id="lightbox" style="display: none;">
  <button class="lightbox-close" id="lightbox-close">&times;</button>
  <div class="lightbox-frame">
    <div class="lightbox-media" id="lightbox-media"></div>
  </div>
</div>

<div class="confirm-modal" id="confirm-modal" style="display: none;">
  <div class="confirm-card">
    <button class="confirm-close" id="confirm-close" aria-label="Cerrar">&times;</button>
    <h3>Revisa tus archivos antes de subir</h3>
    <p class="confirm-count" id="confirm-count"></p>
    <div class="confirm-preview" id="confirm-preview"></div>
    <div class="confirm-actions">
      <button class="btn-cancel" id="btn-cancel">Cancelar</button>
      <button class="btn-upload" id="btn-confirm">Confirmar subida</button>
    </div>
  </div>
</div>

<style is:global>
  .gallery-hero {
    position: relative;
    height: 50vh;
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: url('https://images.unsplash.com/photo-1522673607200-164d1b6ce486?w=1920&q=80') center/cover no-repeat;
    margin-top: -70px;
    padding-top: 70px;
  }

  .gallery-seccion {
    padding: 4rem 2rem;
    background: var(--color-bg);
  }

  .upload-zone {
    background: var(--color-white);
    border: 2px dashed var(--color-primary);
    border-radius: var(--radius-lg);
    padding: 3rem 2rem;
    text-align: center;
    margin-bottom: 3rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    transition: var(--transition);
  }

  .upload-zone.dragover {
    background: var(--color-primary-light);
    border-color: var(--color-primary-hover);
  }

  .upload-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .upload-zone h3 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .upload-zone > p {
    color: var(--color-body-light);
    margin-bottom: 1.5rem;
  }

  .btn-upload {
    background: var(--color-primary);
    color: var(--color-white);
    padding: 0.75rem 2rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .btn-upload:hover {
    background: var(--color-primary-hover);
  }

  .upload-hint {
    font-size: 0.85rem;
    color: var(--color-body-light);
    margin-top: 1rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .gallery-empty {
    text-align: center;
    color: var(--color-body-light);
    font-size: 1rem;
    padding: 2rem 0;
  }

  .gallery-item {
    background: var(--color-white);
    padding: 14px 14px 46px;
    border-radius: 4px;
    box-shadow: var(--shadow-md);
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    transform: rotate(var(--tilt, 0deg));
    animation: polaroid-in 0.4s ease both;
  }

  .gallery-item:hover {
    transform: rotate(0deg) scale(1.06) translateY(-8px);
    box-shadow: var(--shadow-lg);
    z-index: 2;
  }

  .gallery-item img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }

  .gallery-item video {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }

  @keyframes polaroid-in {
    from {
      opacity: 0;
      transform: rotate(var(--tilt, 0deg)) scale(0.85);
    }
    to {
      opacity: 1;
      transform: rotate(var(--tilt, 0deg)) scale(1);
    }
  }

  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    font-size: 2.5rem;
    color: var(--color-white);
    background: none;
    cursor: pointer;
  }

  .lightbox-frame {
    background: var(--color-white);
    padding: 16px 16px 52px;
    border-radius: 4px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    transform: rotate(-1deg);
    animation: lightbox-in 0.25s ease both;
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
      transform: rotate(-1deg) scale(0.9);
    }
    to {
      opacity: 1;
      transform: rotate(-1deg) scale(1);
    }
  }

  .lightbox-media img,
  .lightbox-media video {
    max-width: min(85vw, 800px);
    max-height: 80vh;
    object-fit: contain;
    display: block;
  }

  .lightbox-media video {
    background: #000;
  }

  .confirm-modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .confirm-card {
    background: var(--color-white);
    border-radius: var(--radius-md);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    width: min(90vw, 700px);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    padding: 2rem;
    position: relative;
  }

  .confirm-close {
    position: absolute;
    top: 0.75rem;
    right: 1.25rem;
    font-size: 2rem;
    line-height: 1;
    color: var(--color-body-light);
    background: none;
    cursor: pointer;
  }

  .confirm-close:hover {
    color: var(--color-dark);
  }

  .confirm-card h3 {
    font-family: var(--font-heading);
    color: var(--color-dark);
    margin-bottom: 0.25rem;
  }

  .confirm-count {
    color: var(--color-body-light);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .confirm-preview {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1rem;
    overflow-y: auto;
    padding: 0.25rem;
    flex: 1;
  }

  .confirm-thumb {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transform: rotate(var(--tilt, 0deg));
  }

  .confirm-thumb img,
  .confirm-thumb video {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }

  .confirm-remove {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    color: var(--color-white);
    font-size: 1rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
  }

  .confirm-remove:hover {
    background: var(--color-error);
  }

  .confirm-actions {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-card-bg);
  }

  .btn-cancel {
    background: var(--color-card-bg);
    color: var(--color-dark);
    padding: 0.75rem 2rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .btn-cancel:hover {
    background: #e3dbd2;
  }

  @media (max-width: 768px) {
    .confirm-preview {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .gallery-hero {
      height: 40vh;
    }

    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 1rem;
    }
  }
</style>

<script>
  import { getImagesApiUrl } from '../utils/auth';

  const API_URL = getImagesApiUrl();

  const uploadZone = document.getElementById('upload-zone');
  const fileInput = document.getElementById('file-input');
  const btnUpload = document.getElementById('btn-upload');
  const lightbox = document.getElementById('lightbox');
  const lightboxMedia = document.getElementById('lightbox-media');
  const lightboxClose = document.getElementById('lightbox-close');
  const galleryGrid = document.getElementById('gallery-grid');
  const galleryEmpty = document.getElementById('gallery-empty');
  const confirmModal = document.getElementById('confirm-modal');
  const confirmClose = document.getElementById('confirm-close');
  const confirmPreview = document.getElementById('confirm-preview');
  const confirmCount = document.getElementById('confirm-count');
  const btnCancel = document.getElementById('btn-cancel');
  const btnConfirm = document.getElementById('btn-confirm');

  let pendingFiles: File[] = [];
  let pendingUrls: string[] = [];

  btnUpload?.addEventListener('click', () => {
    fileInput?.click();
  });

  uploadZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    uploadZone.classList.add('dragover');
  });

  uploadZone?.addEventListener('dragleave', () => {
    uploadZone.classList.remove('dragover');
  });

  uploadZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadZone.classList.remove('dragover');
    const files = e.dataTransfer?.files;
    if (!files) return;
    handleFiles(files);
  });

  fileInput?.addEventListener('change', (e) => {
    const files = (e.target as HTMLInputElement).files;
    if (files) handleFiles(files);
  });

  const uploadHint = document.querySelector('.upload-hint');

  async function handleFiles(files: FileList) {
    const mediaFiles = Array.from(files).filter((file) => isSupportedMedia(file));
    if (!mediaFiles.length) return;
    pendingFiles.push(...mediaFiles);
    openPreviewModal();
  }

  function openPreviewModal() {
    if (!pendingFiles.length || !confirmModal) return;
    renderPreview();
    confirmModal.style.display = 'flex';
  }

  function renderPreview() {
    if (!confirmPreview || !confirmCount) return;
    pendingUrls.forEach((url) => URL.revokeObjectURL(url));
    pendingUrls = pendingFiles.map((file) => URL.createObjectURL(file));
    confirmPreview.innerHTML = '';
    pendingFiles.forEach((file, i) => {
      const wrap = document.createElement('div');
      wrap.className = 'confirm-thumb';
      wrap.style.setProperty('--tilt', `${(Math.random() * 4 - 2).toFixed(1)}deg`);
      wrap.innerHTML = `${renderMediaMarkup(pendingUrls[i], file.type, file.name, true)}<button class="confirm-remove" data-index="${i}" aria-label="Quitar archivo">&times;</button>`;
      confirmPreview.appendChild(wrap);
    });
    const count = pendingFiles.length;
    confirmCount.textContent = `${count} archivo${count === 1 ? '' : 's'} seleccionado${count === 1 ? '' : 's'}`;
  }

  confirmPreview?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.confirm-remove');
    if (!btn) return;
    const index = Number((btn as HTMLElement).getAttribute('data-index'));
    pendingFiles.splice(index, 1);
    if (!pendingFiles.length) {
      closePreviewModal();
    } else {
      renderPreview();
    }
  });

  function closePreviewModal() {
    if (confirmModal) confirmModal.style.display = 'none';
    pendingUrls.forEach((url) => URL.revokeObjectURL(url));
    pendingUrls = [];
    pendingFiles = [];
    if (fileInput && fileInput instanceof HTMLInputElement) fileInput.value = '';
  }

  confirmClose?.addEventListener('click', closePreviewModal);
  btnCancel?.addEventListener('click', closePreviewModal);
  confirmModal?.addEventListener('click', (e) => {
    if (e.target === confirmModal) closePreviewModal();
  });

  btnConfirm?.addEventListener('click', async () => {
    const files = [...pendingFiles];
    if (!files.length) return;
    closePreviewModal();
    await uploadBatch(files);
  });

  async function uploadBatch(files: File[]) {
    const formData = new FormData();
    files.forEach((file) => formData.append('files', file));

    try {
      const res = await fetch(`${API_URL}/api/images/batch`, {
        method: 'POST',
        body: formData,
      });

      if (res.ok) {
        const data = await res.json() as { key: string; url: string }[];
        data.forEach((img, i) => {
          if (i === 0) (window as any).playPolaroid?.(img.url);
          addMediaToGrid(img.url);
        });
        const n = data.length;
        showUploadError(`${n} archivo${n === 1 ? '' : 's'} subido${n === 1 ? '' : 's'} correctamente ✅`);
      } else {
        const text = await res.text().catch(() => '');
        showUploadError(`Error al subir los archivos (${res.status}${text ? `: ${text}` : ''})`);
      }
    } catch (err) {
      showUploadError(`No se pudo subir: ${err instanceof Error ? err.message : String(err)}`);
    }
  }

  function showUploadError(message: string) {
    if (!uploadHint) return;
    uploadHint.textContent = message;
    setTimeout(() => {
      uploadHint.textContent = 'Inicia sesión para poder subir fotos y videos';
    }, 6000);
  }

  async function loadGallery() {
    try {
      const res = await fetch(`${API_URL}/api/images`);
      if (!res.ok || !galleryGrid) return;
      const images = await res.json() as { key: string; url: string; size: number; lastModified: string }[];
      if (!images.length) {
        if (galleryEmpty) galleryEmpty.style.display = 'block';
        return;
      }
      if (galleryEmpty) galleryEmpty.style.display = 'none';
      galleryGrid.innerHTML = '';
      images.forEach((img) => addMediaToGrid(img.url));
    } catch {
    }
  }

  loadGallery();

  function addMediaToGrid(url: string) {
    if (!galleryGrid) return;
    if (galleryEmpty) galleryEmpty.style.display = 'none';
    const item = document.createElement('div');
    item.className = 'gallery-item';
    const tilt = (Math.random() * 4 - 2).toFixed(1);
    item.style.setProperty('--tilt', `${tilt}deg`);
    item.innerHTML = `${renderMediaMarkup(url, getMediaTypeFromUrl(url), 'Archivo subido', false)}`;
    item.addEventListener('click', (e) => {
      if ((e.target as HTMLElement | null)?.closest('video')) return;
      openLightbox(url);
    });
    galleryGrid.prepend(item);
  }

  function openLightbox(src: string) {
    if (!lightbox || !lightboxMedia) return;
    const currentVideo = lightboxMedia.querySelector('video');
    if (currentVideo) currentVideo.pause();
    lightboxMedia.innerHTML = renderMediaMarkup(src, getMediaTypeFromUrl(src), 'Archivo subido', false, true);
    lightbox.style.display = 'flex';
  }

  function renderMediaMarkup(src: string, mediaType: string, alt: string, isPreview: boolean, isLightbox = false) {
    const kind = mediaType.startsWith('video/') ? 'video' : 'image';
    if (kind === 'video') {
      const attrs = isLightbox ? 'controls autoplay playsinline' : 'controls muted playsinline preload="metadata"';
      const className = isLightbox ? 'lightbox-video' : 'gallery-video';
      return `<video class="${className}" src="${src}" aria-label="${alt}" ${attrs}></video>`;
    }
    const className = isLightbox ? 'lightbox-image' : isPreview ? 'confirm-image' : 'gallery-image';
    const loading = isLightbox ? '' : 'loading="lazy"';
    return `<img class="${className}" src="${src}" alt="${alt}" ${loading} />`;
  }

  function getMediaTypeFromUrl(url: string) {
    const path = url.split('?')[0].split('#')[0];
    const ext = path.slice(path.lastIndexOf('.') + 1).toLowerCase();
    if (['mp4', 'webm', 'ogg', 'mov', 'm4v'].includes(ext)) return 'video/*';
    return 'image/*';
  }

  function isSupportedMedia(file: File) {
    if (file.type.startsWith('image/') || file.type.startsWith('video/')) return true;
    const name = file.name.toLowerCase();
    return /\.(png|jpe?g|gif|webp|avif|bmp|svg|mp4|webm|ogg|mov|m4v)$/i.test(name);
  }

  lightboxClose?.addEventListener('click', () => {
    if (lightboxMedia) {
      const currentVideo = lightboxMedia.querySelector('video');
      if (currentVideo) currentVideo.pause();
      lightboxMedia.innerHTML = '';
    }
    if (lightbox) lightbox.style.display = 'none';
  });

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      if (lightboxMedia) {
        const currentVideo = lightboxMedia.querySelector('video');
        if (currentVideo) currentVideo.pause();
        lightboxMedia.innerHTML = '';
      }
      lightbox.style.display = 'none';
    }
  });
</script>
